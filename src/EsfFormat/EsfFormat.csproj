<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>EveShipFit.EsfFormat</AssemblyName>
    <RootNamespace>EveShipFit.EsfFormat</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>EveShipFit.EsfFormat</PackageId>
    <Version>0.0.0-dev</Version>
    <Description>Read and write esf/1, the plain-text format for EVE Online ship fits</Description>
    <Authors>EVEShipFit Team</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EVEShipFit/esf-format-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EVEShipFit/esf-format-dotnet</RepositoryUrl>
    <PackageTags>eve-online;fitting;esf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="EveShipFit.EsfFormat.Tests" />
  </ItemGroup>

</Project>
